# Copy to .env and fill in. Never commit .env to GitHub.
SECRET_KEY=change-this-to-a-long-random-string
PRODUCTION=0                 # set to 1 when live (HTTPS)

# Oracle (python-oracledb thin mode, no Oracle client needed)
ORACLE_USER=iterawin
ORACLE_PASSWORD=your-db-password
ORACLE_DSN=host:1521/service_name      # or a TNS alias if you use a wallet
# Autonomous Database only (mTLS wallet folder):
# ORACLE_WALLET_DIR=/path/to/wallet
# ORACLE_WALLET_PASSWORD=wallet-password

# First owner account (created by: python init_db.py)
OWNER_NAME=Your Name
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=use-a-strong-password

REQUIRE_APPROVAL=0           # 1 = you approve each new student before they can log in
# DB=sqlite                  # local testing without Oracle
